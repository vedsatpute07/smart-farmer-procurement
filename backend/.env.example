# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Local MongoDB must be started with --replSet rs0
MONGODB_URI=mongodb://127.0.0.1:27017/farmer_procurement?replicaSet=rs0

# Configure two DIFFERENT strong random secrets locally.
JWT_SECRET=SmartFarmer_JWT_Dev_2026_ChangeThis_9xK7pLm2
JWT_EXPIRES_IN=8h

OTP_HASH_SECRET=SmartFarmer_OTP_Dev_2026_ChangeThis_4qR8vN6z
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Safe installation default.
# Set SMS_MODE=twilio in your local .env to use your Twilio trial account.
SMS_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# monitoring: procurement payment records only.
# razorpay_test: also enable the separate admin-only sandbox checkout demo.
PAYMENT_MODE=monitoring
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Reserved; this MVP uses backend Checkout signature verification, not webhooks.
RAZORPAY_WEBHOOK_SECRET=